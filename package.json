{
  "name": "@pacific-steel-5025/ui",
  "version": "0.1.0",
  "description": "Pacific Steel 5025's accessible React component system.",
  "license": "MIT",
  "author": "Pacific Steel 5025",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frcpacificsteel/5025UI.git"
  },
  "homepage": "https://github.com/frcpacificsteel/5025UI#readme",
  "bugs": {
    "url": "https://github.com/frcpacificsteel/5025UI/issues"
  },
  "keywords": [
    "react",
    "components",
    "base-ui",
    "tailwind",
    "frc",
    "robotics",
    "pacific-steel"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "src/tailwind.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./tailwind.css": "./src/tailwind.css"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "preview": "vite --config preview/vite.config.ts",
    "preview:build": "vite build --config preview/vite.config.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.8.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fontsource/encode-sans": "^5.3.0",
    "@fontsource/encode-sans-semi-expanded": "^5.3.0",
    "@tabler/icons-react": "^3.47.0"
  }
}
